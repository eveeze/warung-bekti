# WarungOS Backend Environment Variables

# Application
APP_ENV=development
LOG_LEVEL=debug
API_VERSION=v1

# Server
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
SERVER_READ_TIMEOUT=15s
SERVER_WRITE_TIMEOUT=15s
SERVER_IDLE_TIMEOUT=60s
SERVER_SHUTDOWN_TIMEOUT=30s

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5435
DB_USER=warung
DB_PASSWORD=warung_secret
DB_NAME=warung_db
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONN_MAX_IDLE_TIME=5m

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0

# Cloudflare R2 (optional locally; image uploads require real credentials)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=warung-assets
R2_PUBLIC_URL=

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION_HOURS=24
JWT_ISSUER=warung-backend

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENV=sandbox
MIDTRANS_MERCHANT_ID=

# OneSignal Notification
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=
